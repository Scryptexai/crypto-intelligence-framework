# CIF Deep-Reset — credentials & tunables. Copy to reset/.env (gitignored) on the VPS.

# DeepSeek research model via Anthropic-compatible endpoint (REQUIRED)
ANTHROPIC_BASE_URL=https://api.hcnsec.cn/
ANTHROPIC_AUTH_TOKEN=sk-REPLACE_ME
ANTHROPIC_MODEL=DeepSeek-V4-Pro

# Model call tuning
DEEP_MAX_TOKENS=16000
DEEP_TIMEOUT=600
DEEP_MAX_RETRIES=5

# Pacing (seconds) — maintainer spec: 60s between phases, 300s (5 min) between projects
RESET_PHASE_DELAY_SEC=60
RESET_PROJECT_DELAY_SEC=300

# Behaviour
RESET_SKIP_FILLED=true        # skip projects whose 11 phases are already non-empty
RESET_OVERWRITE=false         # regenerate even if present
RESET_RUN_PIPELINE=true       # run ./run.sh build after the reset loop
RESET_RUN_SYNC=true           # run ./run.sh sync after build
RESET_MAX_CONTEXT_CHARS=220000
RESET_MIN_PHASE_CHARS=400

# Supabase sync target (used by ./run.sh sync -> tools/sync_supabase.py)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
